<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ '/css/main.css'|url|safe}}">
  <script src="{{ '/map/browser.js'|url|safe}}"></script>
</head>
<body>
    {# Output the API key from the global variable set in eleventy.config.cjs #}
    <script>const apiKey = '{{ apiKey }}';</script>
    <div class="Layout">
        <aside class="Sidebar">
            <p class="Sidebar-title">Gmaps tests</p>
            <nav class="Nav" aria-label="Test pages">
                <ul class="Nav-list">
                    {# The navigation items are set in site-src/_data/nav.json #}
                    {%- for item in nav %}
                    {%- set itemUrl = item.url | url %}
                    {#- Eleventy outputs directory-style URLs, so page.url has a trailing slash ("/infowindow/") that the nav URLs don't #}
                    {%- set isCurrent = page.url == itemUrl or page.url == itemUrl + '/' %}
                    <li class="Nav-item">
                        <a class="Nav-link" href="{{ itemUrl|safe }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.title }}</a>
                    </li>
                    {%- endfor %}
                </ul>
            </nav>
        </aside>
        <main class="Content">
            {{ content | safe }}
        </main>
    </div>
</body>
</html>
