{
    "include": ["src/**/*"],
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        // ES2022 so that the build uses native #private fields. Older targets emulate them with a
        // WeakMap for each field, which is much slower and uses more memory for objects that are
        // created in large numbers, like LatLng. This needs Safari 15 (iOS 15), Chrome 84, or Firefox 90.
        "target": "es2022",
        // Keep assignment semantics for class fields. Typescript turns this on by default for ES2022,
        // which would change how class fields are initialized.
        "useDefineForClassFields": false,
        // Matches the build target so that ES2022 built-ins can be used, like Object.hasOwn and
        // Array.prototype.at. Note that some of them need slightly newer browsers than the
        // target does: Object.hasOwn needs Safari 15.4 and Chrome 93, against the Safari 15 and
        // Chrome 84 that private fields need. Check support before using a new built-in.
        "lib": ["es2022", "dom", "dom.iterable"],
        "types": ["google.maps", "node"],
        "rootDir": "src",
        "outDir": "dist",
        "skipLibCheck": true,
        // All of the strict family. It was strictNullChecks only, which left gaps that only
        // showed up for consumers: a published type that didn't declare its "this" compiles here
        // and fails for anyone with strict on.
        "strict": true
    }
}
